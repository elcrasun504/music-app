<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= siteSettings.siteName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='80'><%= encodeURIComponent(siteSettings.siteEmoji || '🎵') %></text></svg>" />
    <link rel="stylesheet" href="<%= googleFontHref %>" />
    <link rel="stylesheet" href="/public/css/style.css" />
    <style><%- siteCss %></style>
  </head>
  <body
    class="theme-dark <%= siteSettings.seasonTheme ? 'season-mode' : '' %>"
    style="--bg: <%= siteSettings.backgroundColor %>; --panel: <%= siteSettings.cardColor %>; --primary: <%= siteSettings.accentColor %>; --font-body: '<%= siteSettings.bodyFont %>', 'Inter', 'Segoe UI', sans-serif; --font-heading: '<%= siteSettings.headingFont %>', 'Sora', 'Segoe UI', sans-serif; --font-scale: <%= { small: 0.92, medium: 1, large: 1.08, xlarge: 1.2 }[siteSettings.fontScale || 'medium'] %>;"
  >
    <% if (siteSettings.seasonTheme) { %>
      <div class="season-overlay" aria-hidden="true">
        <span class="snowflake">❄</span><span class="snowflake">❄</span><span class="snowflake">❄</span>
      </div>
    <% } %>

    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <% if (siteSettings.logoPath) { %>
            <a href="/" aria-label="Volver a la portada" class="brand-logo-link">
              <img src="<%= siteSettings.logoPath %>" alt="<%= siteSettings.siteName %>" class="brand-logo" />
            </a>
          <% } else { %>
            <a href="/" class="brand-text"><span class="brand-emoji"><%= siteSettings.headerEmoji || '🎧' %></span> <%= siteSettings.siteName %></a>
          <% } %>
        </div>

        <nav class="nav-links">
          <% if (user) { %>
            <span class="user-pill">Hola, <%= user.username %></span>
            <a href="/songs/upload"><%= siteSettings.primaryButtonText || 'Añadir canción' %></a>
            <a href="/playlists"><%= siteSettings.playlistsTitle || 'Mis Playlists' %></a>
            <% if (user.role === 'admin') { %>
              <a href="/admin">Panel de administrador</a>
            <% } %>
            <form action="/auth/logout" method="POST">
              <button type="submit">Cerrar sesión</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Iniciar sesión</a>
            <a href="/auth/register">Registrarse</a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if (flash) { %>
        <div class="toast toast-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <% if (user && userStats) { %>
        <section class="stats-bar" aria-label="Estadísticas del usuario">
          <div class="stat-card">
            <span class="stat-icon">🎵</span>
            <div>
              <strong><%= userStats.songCount %></strong>
              <small>Canciones</small>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">📚</span>
            <div>
              <strong><%= userStats.playlistCount %></strong>
              <small>Playlists</small>
            </div>
          </div>
        </section>
      <% } %>

      <section class="hero">
        <div class="hero-badge"><%= siteSettings.heroEmoji || '✨' %> <%= siteSettings.siteEmoji || '🎵' %></div>
        <h1><%= siteSettings.heroText %></h1>
        <p><%= siteSettings.welcomeText %></p>
      </section>

      <section class="panel">
        <div class="library-header">
          <h2><%= siteSettings.libraryTitle || 'Biblioteca' %></h2>
          <div class="library-actions">
            <% if (user) { %>
              <button type="button" class="secondary-btn small-btn" id="surprise-button">🎲 Sorpréndeme</button>
              <a class="primary-btn" href="/songs/upload"><%= siteSettings.primaryButtonText || 'Añadir canción' %></a>
            <% } %>
          </div>
        </div>

        <div class="search-wrap">
          <input id="library-search" type="search" placeholder="Buscar por título o artista" aria-label="Buscar canciones" />
        </div>

        <div class="easter-egg hidden" id="easter-egg">🎉 ¡Modo Cholu activado! La música siempre tiene buen gusto.</div>

        <% if (songs.length === 0) { %>
          <div class="empty-state">
            <%= siteSettings.emptyStateText || 'Aún no hay canciones — ¡sube la primera!' %>
          </div>
        <% } else { %>
          <div class="song-grid">
            <% songs.forEach((song) => { %>
              <article class="song-card" data-search="<%= song.title %> <%= song.artist %>" data-song-id="<%= song.id %>" data-song-title="<%= song.title %>" data-song-artist="<%= song.artist %>" data-song-cover="<%= song.coverPath || '/public/images/placeholder-cover.svg' %>" data-song-src="<%= song.filepath %>" data-song-duration="<%= song.duration || 0 %>">
                <div class="song-cover-wrap">
                  <img
                    src="<%= song.coverPath || '/public/images/placeholder-cover.svg' %>"
                    alt="Carátula de <%= song.title %>"
                    class="song-cover"
                    onerror="this.onerror=null;this.src='/public/images/placeholder-cover.svg';"
                  />
                </div>

                <div class="song-meta">
                  <span class="pill"><%= song.artist %></span>
                  <span>por <%= song.uploader_username %></span>
                </div>

                <h3 class="song-title"><%= song.title %></h3>
                <div class="player-mini-row">
                  <button type="button" class="icon-btn" data-play-song="<%= song.id %>" aria-label="Reproducir <%= song.title %>">▶</button>
                  <span class="song-duration"><%= song.duration ? Math.floor(song.duration / 60) + ':' + String(song.duration % 60).padStart(2, '0') : '0:00' %></span>
                </div>

                <% if (user && user.id === song.uploader_id) { %>
                  <div class="song-actions">
                    <button type="button" class="secondary-btn small-btn" data-toggle-edit="<%= song.id %>">Editar</button>
                    <button
                      type="button"
                      class="danger-btn small-btn confirm-trigger"
                      data-confirm-form="delete-song-form-<%= song.id %>"
                      data-confirm-title="¿Seguro que quieres eliminar '<%= song.title %>'?"
                      data-confirm-message="Esta acción no se puede deshacer."
                    >
                      🗑️
                    </button>
                  </div>

                  <form class="edit-song-form hidden" data-edit-form="<%= song.id %>" method="POST" action="/songs/<%= song.id %>/edit">
                    <label>
                      Título
                      <input name="title" type="text" value="<%= song.title %>" required />
                    </label>
                    <label>
                      Artista
                      <input name="artist" type="text" value="<%= song.artist %>" required />
                    </label>
                    <button class="primary-btn small-btn" type="submit">Guardar</button>
                  </form>

                  <form id="delete-song-form-<%= song.id %>" method="POST" action="/songs/<%= song.id %>/delete" class="hidden"></form>
                <% } %>

                <% if (user) { %>
                  <% if (userPlaylists.length > 0) { %>
                    <form class="playlist-form" action="/playlists/add-song" method="POST">
                      <input type="hidden" name="song_id" value="<%= song.id %>" />
                      <select name="playlist_id" required>
                        <option value="">Añadir a una playlist</option>
                        <% userPlaylists.forEach((playlist) => { %>
                          <option value="<%= playlist.id %>"><%= playlist.name %></option>
                        <% }); %>
                      </select>
                      <button class="primary-btn" type="submit">Agregar a playlist</button>
                    </form>
                  <% } else { %>
                    <p class="muted">Crea una playlist en <a href="/playlists">Mis playlists</a>.</p>
                  <% } %>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% } %>
      </section>
    </main>

    <footer class="site-footer">
      <p><%= siteSettings.footerText || 'Hecho con ❤️ para la comunidad.' %></p>
    </footer>

    <div class="global-player" id="global-player">
      <div class="global-player-cover-wrap">
        <img id="global-player-cover" src="/public/images/placeholder-cover.svg" alt="Carátula actual" />
      </div>
      <div class="global-player-meta">
        <strong id="global-player-title">Selecciona una canción</strong>
        <span id="global-player-artist"><%= siteSettings.siteName %></span>
      </div>
      <div class="global-player-controls">
        <button type="button" class="primary-btn small-btn" id="global-player-toggle">▶</button>
      </div>
      <div class="global-player-progress-wrap">
        <div class="global-player-time-row">
          <span id="global-player-current">0:00</span>
          <span id="global-player-total">0:00</span>
        </div>
        <div class="global-player-progress" id="global-player-progress" aria-label="Barra de progreso de reproducción">
          <span id="global-player-progress-bar"></span>
        </div>
      </div>
      <audio id="global-audio" preload="metadata"></audio>
    </div>

    <div class="modal-backdrop" id="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
      <div class="modal-card">
        <h3 id="confirm-modal-title">Confirmación</h3>
        <p id="confirm-modal-message">¿Estás seguro?</p>
        <div class="modal-actions">
          <button type="button" class="secondary-btn small-btn" id="confirm-modal-cancel">Cancelar</button>
          <button type="button" class="danger-btn small-btn" id="confirm-modal-confirm">Confirmar</button>
        </div>
      </div>
    </div>

    <script src="/public/js/main.js"></script>
  </body>
</html>
