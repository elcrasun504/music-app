<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis playlists | <%= siteSettings.siteName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/style.css" />
  </head>
  <body
    class="theme-dark"
    style="--bg: <%= siteSettings.backgroundColor %>; --panel: <%= siteSettings.cardColor %>; --primary: <%= siteSettings.accentColor %>; --font-body: '<%= siteSettings.typography %>', 'Inter', 'Segoe UI', sans-serif;"
  >
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <% if (siteSettings.logoPath) { %>
            <a href="/" aria-label="Volver a la portada">
              <img src="<%= siteSettings.logoPath %>" alt="<%= siteSettings.siteName %>" class="brand-logo" />
            </a>
          <% } else { %>
            <a href="/" class="brand-text"><%= siteSettings.siteName %></a>
          <% } %>
        </div>
        <nav class="nav-links">
          <a href="/">Biblioteca</a>
          <a href="/songs/upload">Subir canción</a>
          <% if (user && user.role === 'admin') { %>
            <a href="/admin">Panel de administrador</a>
          <% } %>
          <form action="/auth/logout" method="POST">
            <button type="submit">Cerrar sesión</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if (flash) { %>
        <div class="toast toast-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <section class="section-header">
        <h1>Mis playlists</h1>
        <a class="primary-btn" href="/">Volver a la biblioteca</a>
      </section>

      <% if (error) { %>
        <div class="notice error"><%= error %></div>
      <% } %>

      <section class="panel card-soft" style="padding: 1.25rem; margin-bottom: 1.5rem;">
        <h2>Crear playlist</h2>
        <form action="/playlists/create" method="POST" class="inline-form">
          <input type="text" name="name" placeholder="Nombre de la playlist" required />
          <button class="primary-btn" type="submit">Crear</button>
        </form>
      </section>

      <section class="playlist-list">
        <% if (playlists.length === 0) { %>
          <div class="empty-state">
            Aún no hay playlists — crea la primera.
          </div>
        <% } else { %>
          <% playlists.forEach((playlist) => { %>
            <article class="playlist-card">
              <div class="playlist-info">
                <h3><%= playlist.name %></h3>
                <span class="muted">Playlist creada el <%= new Date(playlist.createdAt).toLocaleDateString('es-ES') %></span>
              </div>

              <div class="playlist-actions">
                <a class="secondary-btn small-btn" href="/playlists/<%= playlist.id %>">Ver playlist</a>

                <form class="inline-form" action="/playlists/<%= playlist.id %>/rename" method="POST">
                  <input type="text" name="name" value="<%= playlist.name %>" required />
                  <button class="primary-btn small-btn" type="submit">Renombrar</button>
                </form>

                <button
                  type="button"
                  class="danger-btn small-btn confirm-trigger"
                  data-confirm-form="delete-playlist-form-<%= playlist.id %>"
                  data-confirm-title="¿Seguro que quieres eliminar '<%= playlist.name %>'?"
                  data-confirm-message="Se eliminará la playlist y sus referencias. Las canciones no se borrarán del catálogo global."
                >
                  Eliminar
                </button>

                <form id="delete-playlist-form-<%= playlist.id %>" action="/playlists/<%= playlist.id %>/delete" method="POST" class="hidden"></form>
              </div>
            </article>
          <% }); %>
        <% } %>
      </section>
    </main>

    <div class="modal-backdrop" id="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
      <div class="modal-card">
        <h3 id="confirm-modal-title">Confirmación</h3>
        <p id="confirm-modal-message">¿Estás seguro?</p>
        <div class="modal-actions">
          <button type="button" class="secondary-btn small-btn" id="confirm-modal-cancel">Cancelar</button>
          <button type="button" class="danger-btn small-btn" id="confirm-modal-confirm">Confirmar</button>
        </div>
      </div>
    </div>

    <script src="/public/js/main.js"></script>
  </body>
</html>
